table _Measures
	lineageTag: 40750b10-3850-4ab6-a5a3-7e310f488555

	measure 'Current Stock' =
			
			CALCULATE(
			    SUM(FactProductInventory[UnitsBalance]),
			    LASTDATE(FactProductInventory[MovementDate]),
			    DimProduct
			)
		formatString: 0
		lineageTag: dae18650-291a-4e1d-8512-b2f6afe2cb33

	measure 'Total Inventory Value' =
			
			CALCULATE(
			    SUMX(
			        FactProductInventory,
			        FactProductInventory[UnitsBalance] * RELATED(DimProduct[StandardCost])
			    ),
			    LASTDATE(FactProductInventory[MovementDate]),
			    DimProduct
			)
		formatString: "₹"\ #,0.###############;#,0.###############\ -"₹";"₹"\ #,0.###############
		lineageTag: ca6bba26-a588-49af-a58d-e2ba692aad34

		annotation PBI_FormatHint = {"currencyCulture":"en-IN"}

	measure 'Negative Balance Flag Count' =
			
			CALCULATE(
			    COUNTROWS(FactProductInventory),
			    FactProductInventory[UnitsBalance] < 0,
			    DimProduct
			)
		formatString: 0
		lineageTag: 038d12cb-1c8e-44f0-a0dc-d8086bfb2f7a

	measure 'Total Units Sold' = SUM(FactInternetSales[OrderQuantity])
		formatString: 0
		lineageTag: 45a319e6-f868-4069-beba-63b1f6e3b5c9

	measure 'Avg Daily Sales (90d)' = ```
			
			VAR AsOfDate = MAX(FactInternetSales[OrderDate])
			VAR WindowStart = AsOfDate - 90
			VAR UnitsIn90 = 
			    CALCULATE(
			        SUM(FactInternetSales[OrderQuantity]),
			        FactInternetSales[OrderDate] > WindowStart,
			        FactInternetSales[OrderDate] <= AsOfDate,
			        ALL(FactInternetSales[OrderDate])
			    )
			RETURN
			    DIVIDE(UnitsIn90, 90)
			```
		lineageTag: 76b9aa54-7a2c-49de-9794-0eec7b20b3c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Assumed Lead Time Days' =
			
			IF(
			    SELECTEDVALUE(DimProduct[DaysToManufacture]) = 0,
			    7,
			    SELECTEDVALUE(DimProduct[DaysToManufacture])
			)
		formatString: 0
		lineageTag: 003dd57a-d73d-4266-b752-3ba6647d9d32

	measure 'Calculated Reorder Point' =
			
			ROUND(
			    [Avg Daily Sales (90d)] * ([Assumed Lead Time Days] + 7),
			    0
			)
		lineageTag: f2ea95b5-9a08-4b6b-8dfc-fdb6b33fc629

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stockout Risk %' = ```
			
			VAR ProductsAtRisk = 
			    CALCULATE(
			        DISTINCTCOUNT(DimProduct[ProductKey]),
			        FILTER(
			            DimProduct,
			            [Current Stock] <= [Calculated Reorder Point]
			        )
			    )
			VAR TotalProducts = DISTINCTCOUNT(DimProduct[ProductKey])
			RETURN
			    DIVIDE(ProductsAtRisk, TotalProducts)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 43bd85ec-d082-4b71-bedf-4defef4d3b96

	measure 'Reorder Quantity Suggested' =
			
			VAR TargetStock = [Avg Daily Sales (90d)] * ([Assumed Lead Time Days] + 30)
			VAR Shortfall = TargetStock - [Current Stock]
			RETURN
			    IF(Shortfall > 0, ROUND(Shortfall, 0), 0)
		lineageTag: 40c5365b-0c78-49bb-a72f-9e630dba6d09

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Stock Status Color' =
			
			IF(
			    [Current Stock] <= [Calculated Reorder Point],
			    "#FADBD8",
			    "#FFFFFF"
			)
		lineageTag: b294243a-3622-4671-9451-1717f75e98af

	measure 'Days of Cover' =
			
			DIVIDE ( [Current Stock], [Avg Daily Sales (90d)] )
		formatString: 0.0
		lineageTag: c9e4c01a-31c8-48e0-acab-99a3ade09a62

	measure 'Cover Gap Days' =
			
			VAR _cover = [Days of Cover]
			RETURN
			    IF ( ISBLANK ( _cover ), BLANK (), _cover - [Assumed Lead Time Days] )
		formatString: 0.0
		lineageTag: b98e5109-d33a-40ec-97d8-f6900e46713e

	measure 'Products Stocking Out Before Delivery' =
			
			COUNTROWS (
			    FILTER (
			        VALUES ( DimProduct[EnglishProductName] ),
			        [Cover Gap Days] < 0
			            && [Reorder Quantity Suggested] > 0
			    )
			)
		formatString: 0
		lineageTag: 2a9aacc7-05ca-4f7f-9a8f-40d12c577db2

	measure 'Top 4 Reorder Share' = ```
			
			DIVIDE (
			    SUMX (
			        TOPN ( 4, VALUES ( DimProduct[EnglishProductName] ), [Reorder Quantity Suggested] ),
			        [Reorder Quantity Suggested]
			    ),
			    [Reorder Quantity Suggested]
			)
			
			```
		lineageTag: 9435d6af-1437-4450-b119-31e9d19bdf28

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reorder Insight Text' =
			
			"Stock on hand covers only " & FORMAT ( [Days of Cover], "0.0" ) &
			" days of sales. " & [Products Stocking Out Before Delivery] &
			" products will run out before a new order can arrive."
		lineageTag: a4e12fe3-e89c-4f17-8993-4069af5d8d7a

	column Column1
		dataType: string
		lineageTag: 5f190ef5-359b-4ba1-92b3-8449557ac54f
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				  Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

