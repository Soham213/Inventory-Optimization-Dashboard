	column 'SoldProductKeys.ProductKey'
		dataType: int64
		formatString: 0
		lineageTag: e49588cb-6cb9-4194-8ddd-6dba08fa1926
		summarizeBy: count
		sourceColumn: SoldProductKeys.ProductKey

		annotation SummarizationSetBy = Automatic

	column 'Mover Category' = ```
			
			VAR ThisRank = 
			    RANKX(
			        ALL(DimProduct),
			        CALCULATE(SUM(FactInternetSales[OrderQuantity])),
			        ,
			        DESC
			    )
			VAR TotalProducts = COUNTROWS(ALL(DimProduct))
			RETURN
			    SWITCH(
			        TRUE(),
			        ThisRank <= TotalProducts / 3, "Fast Mover",
			        ThisRank <= TotalProducts * 2 / 3, "Medium Mover",
			        "Slow Mover"
			    )
			```
		lineageTag: cf301fed-a121-4460-ba37-34b4f4a2b64f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

